Bootstrap:      localimage
From:           base/ubuntu_24.04.sif

%files
    /etc/bashrc /etc/bashrc

%environment
    export SIMAGE_NAME="Ubuntu/24.04 OpenPBS"
    export AMS_XSTARTUP=ON
    export SINGULARITY_SHELL=/bin/bash
    export LC_ALL=en_US.UTF-8
    export LANG=en_US.UTF-8

%post -c /bin/bash

    # update package repository
    cat /etc/apt/sources.list.d/ubuntu.sources
    apt-get update

    # OpenPBS
    DEBIAN_FRONTEND=noninteractive apt-get install -y lsb-release gcc make libtool libhwloc-dev libx11-dev \
                    libxt-dev libedit-dev libical-dev libncurses-dev perl-base \
                    postgresql-server-dev-all postgresql-contrib python3-dev tcl-dev tk-dev swig \
                    libexpat1-dev libssl-dev libxext-dev libxft-dev autoconf \
                    automake dh-make expat libedit2 postgresql python3 postgresql-contrib \
                    sudo tcl tk libical3t64 heimdal-dev git libcjson-dev python-dev-is-python3

    locale-gen "en_US.UTF-8"

%post -c /bin/bash
    CUSTOM_ENV=/.singularity.d/env/99-zz_custom_env.sh
    cat >$CUSTOM_ENV <<EOF
#!/bin/bash
PS1='\[\033[01;31m\][\$SIMAGE_NAME \u@\h \W]$ \[\033[0m\]'
EOF
    chmod 755 $CUSTOM_ENV

